{
  "name": "trading-concepts-ts",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript library unifying Smart Money Concepts (SMC), ICT, and Price Action for trading bots, charting tools, and backtesting engines. Fine-tunable per exchange, market, and symbol.",
  "keywords": [
    "trading",
    "smart-money-concepts",
    "smc",
    "ict",
    "price-action",
    "order-block",
    "fair-value-gap",
    "fvg",
    "liquidity",
    "market-structure",
    "technical-analysis",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shubham Taywade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/trading-concepts-ts.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "example:crypto": "tsx examples/crypto-binance.ts",
    "example:forex": "tsx examples/forex.ts",
    "example:index": "tsx examples/nse-index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
